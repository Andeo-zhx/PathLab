{
  "name": "pathlab-desktop",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify": "node scripts/acceptance.mjs",
    "verify:ui": "node scripts/acceptance-ui.mjs",
    "desktop": "npm run build && electron .",
    "package:portable": "npm run build && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dexie": "^4.4.6",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "immer": "^11.1.18",
    "jszip": "^3.10.2",
    "konva": "^10.7.0",
    "lucide-react": "^1.48.0",
    "oxlint": "^1.81.0",
    "puppeteer-core": "^25.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "local.pathlab.desktop.v132",
    "productName": "PathLab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/splash.html",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "artifactName": "PathLab-Desktop-${version}-win-${arch}.${ext}",
    "electronDist": "node_modules/electron/dist",
    "win": {
      "icon": "public/pathlab.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
